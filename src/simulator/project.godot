; Engine configuration file.
; Gelderland Operator Academy — crane & lifting simulator
config_version=5

[application]

config/name="Gelderland Operator Academy"
config/description="Evidence-driven crane operator training simulator. Training aid only — not a legal certificate (TCVT/VCA/driving licence). Load charts are training envelopes, not manufacturer data."
run/main_scene="res://ui/boot.tscn"
config/icon="res://icon.svg"

[autoload]

; Order matters: the catalogues and Loc must exist before GameState reads the
; saved profile and validates the stored selection against them.
MachineCatalog="*res://core/machine_catalog.gd"
EnvironmentCatalog="*res://core/environment_catalog.gd"
Weather="*res://core/weather.gd"
MaterialLibrary="*res://core/materials.gd"
ControlScheme="*res://core/control_scheme.gd"
ScenarioDB="*res://core/scenario_db.gd"
Loc="*res://core/loc.gd"
AppSettings="*res://core/settings.gd"
InputConfig="*res://core/input_config.gd"
GameState="*res://core/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
; The web build runs on the Compatibility renderer: Forward+ needs Vulkan and
; browsers only offer WebGL2. Godot switches on this override automatically for
; web exports; the desktop build is untouched. Weather.apply() and
; MaterialLibrary degrade SSAO/texture size on the same feature flag.
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.11, 1)
